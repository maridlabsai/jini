{
  "title": "Jini Tasks",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "artifact_type",
    "schema_version",
    "work_unit_id",
    "branch_id",
    "revision",
    "status",
    "author_actor_id",
    "approver_actor_ids",
    "created_at",
    "updated_at",
    "supersedes",
    "references",
    "change_class",
    "tasks",
    "ownership",
    "status_per_task",
    "blocked_by",
    "deliverables"
  ],
  "properties": {
    "artifact_id": { "type": "string" },
    "artifact_type": { "type": "string", "enum": ["Tasks"] },
    "schema_version": { "type": "string" },
    "work_unit_id": { "type": "string" },
    "branch_id": { "type": "string" },
    "revision": { "type": "integer", "minimum": 1 },
    "status": { "type": "string", "enum": ["draft", "reviewed", "approved", "superseded", "invalidated", "merged", "archived"] },
    "author_actor_id": { "type": "string" },
    "approver_actor_ids": { "type": "array", "items": { "type": "string" } },
    "created_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "updated_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "supersedes": { "type": "string" },
    "references": { "type": "array", "items": { "type": "string" } },
    "change_class": { "type": "string", "enum": ["editorial", "semantic", "breaking"] },
    "tasks": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "ownership": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "status_per_task": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "blocked_by": { "type": "array", "items": { "type": "string" } },
    "deliverables": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "output_notes": { "type": "array", "items": { "type": "string" } },
    "output_refs": { "type": "array", "items": { "type": "string" } }
  }
}
