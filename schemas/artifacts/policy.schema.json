{
  "title": "Jini Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "artifact_type",
    "schema_version",
    "work_unit_id",
    "branch_id",
    "revision",
    "status",
    "author_actor_id",
    "approver_actor_ids",
    "created_at",
    "updated_at",
    "supersedes",
    "references",
    "change_class",
    "policy_id",
    "policy_version",
    "target_decision_surface",
    "allowed_profiles",
    "allowed_extensions",
    "objective_weights",
    "hard_constraints",
    "training_data_range",
    "rollback_policy",
    "candidate_actions",
    "recommended_action",
    "rationale"
  ],
  "properties": {
    "artifact_id": { "type": "string" },
    "artifact_type": { "type": "string", "enum": ["Policy"] },
    "schema_version": { "type": "string" },
    "work_unit_id": { "type": "string" },
    "branch_id": { "type": "string" },
    "revision": { "type": "integer", "minimum": 1 },
    "status": { "type": "string", "enum": ["draft", "reviewed", "approved", "superseded", "invalidated", "merged", "archived"] },
    "author_actor_id": { "type": "string" },
    "approver_actor_ids": { "type": "array", "items": { "type": "string" } },
    "created_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "updated_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "supersedes": { "type": "string" },
    "references": { "type": "array", "items": { "type": "string" } },
    "change_class": { "type": "string", "enum": ["editorial", "semantic", "breaking"] },
    "policy_id": { "type": "string" },
    "policy_version": { "type": "string" },
    "target_decision_surface": { "type": "string" },
    "allowed_profiles": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "allowed_extensions": { "type": "array", "items": { "type": "string" } },
    "objective_weights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["efficiency", "correctness", "completeness", "safety"],
      "properties": {
        "efficiency": { "type": "number", "minimum": 0 },
        "correctness": { "type": "number", "minimum": 0 },
        "completeness": { "type": "number", "minimum": 0 },
        "safety": { "type": "number", "minimum": 0 }
      }
    },
    "hard_constraints": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "training_data_range": { "type": "string" },
    "rollback_policy": { "type": "string" },
    "candidate_actions": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "recommended_action": { "type": "string" },
    "rationale": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
  }
}
