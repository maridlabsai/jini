{
  "title": "Jini Experiment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "artifact_type",
    "schema_version",
    "work_unit_id",
    "branch_id",
    "revision",
    "status",
    "author_actor_id",
    "approver_actor_ids",
    "created_at",
    "updated_at",
    "supersedes",
    "references",
    "change_class",
    "experiment_id",
    "control_policy",
    "treatment_policy",
    "target_population",
    "success_metrics",
    "stopping_rules",
    "observed_uplift"
  ],
  "properties": {
    "artifact_id": { "type": "string" },
    "artifact_type": { "type": "string", "enum": ["Experiment"] },
    "schema_version": { "type": "string" },
    "work_unit_id": { "type": "string" },
    "branch_id": { "type": "string" },
    "revision": { "type": "integer", "minimum": 1 },
    "status": { "type": "string", "enum": ["draft", "reviewed", "approved", "superseded", "invalidated", "merged", "archived"] },
    "author_actor_id": { "type": "string" },
    "approver_actor_ids": { "type": "array", "items": { "type": "string" } },
    "created_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "updated_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "supersedes": { "type": "string" },
    "references": { "type": "array", "items": { "type": "string" } },
    "change_class": { "type": "string", "enum": ["editorial", "semantic", "breaking"] },
    "experiment_id": { "type": "string" },
    "control_policy": { "type": "string" },
    "treatment_policy": { "type": "string" },
    "target_population": { "type": "string" },
    "success_metrics": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "stopping_rules": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "observed_uplift": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
  }
}
