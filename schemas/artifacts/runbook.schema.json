{
  "title": "Jini Runbook",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "artifact_type",
    "schema_version",
    "work_unit_id",
    "branch_id",
    "revision",
    "status",
    "author_actor_id",
    "approver_actor_ids",
    "created_at",
    "updated_at",
    "supersedes",
    "references",
    "change_class",
    "service_scope",
    "routine_ops",
    "escalation_rules",
    "recovery_steps",
    "owner",
    "review_cadence"
  ],
  "properties": {
    "artifact_id": { "type": "string" },
    "artifact_type": { "type": "string", "enum": ["Runbook"] },
    "schema_version": { "type": "string" },
    "work_unit_id": { "type": "string" },
    "branch_id": { "type": "string" },
    "revision": { "type": "integer", "minimum": 1 },
    "status": { "type": "string", "enum": ["draft", "reviewed", "approved", "superseded", "invalidated", "merged", "archived"] },
    "author_actor_id": { "type": "string" },
    "approver_actor_ids": { "type": "array", "items": { "type": "string" } },
    "created_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "updated_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "supersedes": { "type": "string" },
    "references": { "type": "array", "items": { "type": "string" } },
    "change_class": { "type": "string", "enum": ["editorial", "semantic", "breaking"] },
    "service_scope": { "type": "string" },
    "routine_ops": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "escalation_rules": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "recovery_steps": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "owner": { "type": "string" },
    "review_cadence": { "type": "string" }
  }
}
