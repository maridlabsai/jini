{
  "title": "Jini WorkUnit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "work_unit_id",
    "title",
    "purpose",
    "current_state",
    "profile_id",
    "active_extensions",
    "branch_id",
    "owner_actor_id",
    "approver_actor_ids",
    "stakeholder_actor_ids",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "work_unit_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "current_state": {
      "type": "string",
      "enum": [
        "intake",
        "scoped",
        "probed",
        "modeled",
        "decided",
        "in_make",
        "awaiting_verification",
        "operational",
        "reopened",
        "incident",
        "retired"
      ]
    },
    "profile_id": {
      "type": "string",
      "enum": [
        "Explore",
        "Delivery",
        "Critical",
        "Regulated",
        "Incident"
      ]
    },
    "active_extensions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "branch_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_work_unit_id": {
      "type": "string"
    },
    "owner_actor_id": {
      "type": "string",
      "minLength": 1
    },
    "approver_actor_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "operator_actor_id": {
      "type": "string"
    },
    "rollback_authority_actor_id": {
      "type": "string"
    },
    "service_owner_actor_id": {
      "type": "string"
    },
    "stakeholder_actor_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "updated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
